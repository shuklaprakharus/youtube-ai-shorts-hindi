    [
      {
        "t": "पेड़ से गिरा मीठा आम, पानी में छपाक-छपाक!",
        "who": "n"
      }
    ],
    [
      {
        "t": "पीलू ने झट चोंच में पकड़ा, ले भागी वो चुपचाप!",
        "who": "n"
      }
    ],
    [
      {
        "t": "घास के पीछे बैठी पीलू, अकेले-अकेले खाए,",
        "who": "n"
      }
    ],
    [
      {
        "t": "पर ना भैया, ना कोई साथी — मन उसका घबराए!",
        "who": "n"
      }
    ],
    [
      {
        "t": "कमल-पत्ते से मेंढक बोला,",
