  },
  "lines": [
    [
      {
        "t": "पीली-पीली, नन्ही-मुन्नी, प्यारी बतख पीलू,",
        "who": "n"
      }
    ],
    [
      {
        "t": "मम्मी के संग तैर रही है, छप-छप करती पीलू!",
        "who": "n"
      }
    ],
    [
      {
        "t": "रंग-बिरंगी तितली आई, पंख हिलाती फर-फर,",
        "who": "n"
      }
    ],
    [
      {
        "t": "पीलू भागी उसके पीछे, घास के अंदर सर-सर!",
        "who": "n"
      }
    ],
    [
      {
        "t": "मुड़कर देखा — कोई नहीं! ना मम्मी, ना भाई,",
        "who": "n"
      }
    ],
    [
      {
        "t": "आँखें भर आईं पीलू की,",
        "who": "n"
      },
      {
        "t": "मम्मी! मम्मी!",
        "who": "peelu"
      },
      {
        "t": "चिल्लाई।",
        "who": "n"
      }
    ],
    [
      {
        "t": "कमल-पत्ते से मेंढक बोला,",
        "who": "n"
      },
      {
        "t": "टर्र-टर्र, घबराओ ना!",
        "who": "frog"
      }
    ],
    [
      {
        "t": "जहाँ हो तुम, वहीं रुको बस, इधर-उधर तुम जाओ ना!",
        "who": "frog"
      }
    ],
    [
      {
        "t": "मछली बोली,",
        "who": "n"
      },
      {
        "t": "ज़ोर से बोलो!",
        "who": "fish"
      },
      {
        "t": "पीलू बोली,",
        "who": "n"
      },
      {
        "t": "क्वैक-क्वैक!",
        "who": "peelu"
      }
    ],
    [
      {
        "t": "दूर से मम्मी ने सुन लिया, झट से आई — क्वैक-क्वैक!",
        "who": "n"
      }
    ],
    [
      {
        "t": "मम्मी ने पंखों में भर लिया, सबने ताली बजाई,",
        "who": "n"
      }
    ],
    [
      {
        "t": "खो जाओ तो वहीं रुको, ज़ोर से बोलो — ये सीख सिखाई!",
        "who": "n"
      }
    ]
  ],
  "outro": "बाय-बाय बच्चों! और गीतों के लिए सब्सक्राइब करें!",
